NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://scei:scei@localhost:5432/scei
DATABASE_POOL_MAX=10

# Genera secretos propios (no hay valores por defecto):
#   JWT_ACCESS_SECRET / SIGNING_KEY:  openssl rand -base64 48
#   MASTER_KEY (32 bytes):            openssl rand -base64 32
JWT_ACCESS_SECRET=
SIGNING_KEY=
MASTER_KEY=
JWT_ISSUER=scei-platform
JWT_AUDIENCE=scei-api
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=14
MFA_CHALLENGE_TTL_SECONDS=300

LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
RATE_LIMIT_PER_MINUTE=120
AUTH_RATE_LIMIT_PER_MINUTE=10

INVITATION_TTL_HOURS=72
TENANT_PURGE_GRACE_DAYS=7

CORS_ORIGINS=http://localhost:3001
TRUST_PROXY=false
SWAGGER_ENABLED=true
APP_PUBLIC_URL=http://localhost:3001
